# Copy this file to .env (never commit .env) and fill in the values from
# Cloudflare dashboard > R2 > Manage API tokens (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=slymap-assets
# Only for buckets in a jurisdiction (e.g. EU) or for testing:
# R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
