# Copy this file to .env (never commit .env) and fill in the values.
#
# R2_ACCOUNT_ID: the 32-character Account ID from the R2 overview page, or
# the bucket's "S3 API" URL from its Settings tab, e.g.
# https://<account-id>.r2.cloudflarestorage.com/slymap-assets
# (EU buckets have .eu. in that URL; pasting it handles that).
R2_ACCOUNT_ID=
# From R2 > Manage API tokens, with Object Read & Write access:
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=slymap-assets
# Only for testing against another S3-compatible server:
# R2_ENDPOINT=http://localhost:9000
